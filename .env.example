# Copy to .env and replace every change-me value before starting the stack.
APP_ENV=development
LOG_LEVEL=INFO
DOCUMENTS_PATH=./documents
POSTGRES_DB=desktop_agent
POSTGRES_USER=desktop_agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://desktop_agent:change-me@postgres:5432/desktop_agent
REDIS_URL=redis://redis:6379/0
PINECONE_API_KEY=change-me
PINECONE_INDEX=desktop-agent
PINECONE_HOST=https://change-me.svc.pinecone.io
PINECONE_NAMESPACE=documents-v1
EMBEDDING_MODEL_ALIAS=embedding-default
EMBEDDING_DIMENSION=1536
CHAT_MODEL_ALIASES=chat-default
CHAT_MODEL_ALIAS=chat-default
CHAT_PROVIDER_MODEL=change-me
CHAT_PROVIDER_API_KEY=change-me
EMBEDDING_PROVIDER_MODEL=change-me
EMBEDDING_PROVIDER_API_KEY=change-me
LLM_GATEWAY_URL=http://llm-gateway:4000
LLM_GATEWAY_API_KEY=change-me
APP_API_KEY=change-me
API_BASE_URL=http://api-gateway
PUBLIC_API_BASE_URL=http://localhost:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=change-me
LANGSMITH_PROJECT=gangaram-rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=false
INDEX_SYNC_INTERVAL_SECONDS=300
INDEX_RETRY_ATTEMPTS=3
